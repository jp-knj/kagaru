{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kagaru edit operations",
  "type": "array",
  "items": { "$ref": "#/$defs/operation" },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "missing": {
      "type": "object",
      "required": ["missing"],
      "properties": { "missing": { "const": true } },
      "additionalProperties": false
    },
    "valueExpectation": {
      "oneOf": [
        { "$ref": "#/$defs/missing" },
        {
          "type": "object",
          "required": ["value"],
          "properties": { "value": { "$ref": "#/$defs/jsonValue" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["expression"],
          "properties": { "expression": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "importExpectation": {
      "oneOf": [
        { "$ref": "#/$defs/missing" },
        {
          "type": "object",
          "required": ["from", "imported", "kind"],
          "properties": {
            "from": { "type": "string" },
            "imported": { "type": "string" },
            "kind": { "enum": ["value", "type"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path", "expect"],
          "properties": {
            "op": { "enum": ["set", "append"] },
            "expect": { "$ref": "#/$defs/valueExpectation" },
            "path": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "value": { "$ref": "#/$defs/jsonValue" },
            "expression": { "type": "string" }
          },
          "oneOf": [{ "required": ["value"] }, { "required": ["expression"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "from", "local", "expect"],
          "properties": {
            "op": { "const": "addImport" },
            "expect": { "$ref": "#/$defs/importExpectation" },
            "from": { "type": "string" },
            "local": {
              "type": "string",
              "minLength": 1,
              "description": "A single JavaScript module binding identifier. Syntax is validated by Kagaru."
            },
            "imported": { "type": "string", "default": "default" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
